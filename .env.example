# Copy this to .env and fill in your keys
# NEVER commit .env to git

# Pick ONE LLM provider:
OPENAI_API_KEY=sk-...           # Option A: OpenAI (paid, best quality)
GROQ_API_KEY=gsk_...            # Option B: Groq (free tier, fast, good enough)

# Model selection
LLM_PROVIDER=groq               # "openai" or "groq"
LLM_MODEL=openai/gpt-oss-120b   # groq default
# LLM_MODEL=gpt-4o-mini         # openai default (cheap + good)

# Agent config
CONFIDENCE_THRESHOLD=0.7        # Below this → flag for human review
CHROMA_PERSIST_DIR=./data/chroma_db
