# Copy this to .env for runs outside your shell (IDE run buttons, servers).
# Variables already exported in your shell take precedence over this file.
# NEVER commit .env to git — it is in .gitignore.

# Pick ONE LLM provider: "openrouter" (default), "groq" or "openai"
LLM_PROVIDER=openrouter

# OpenRouter (default) — key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Groq / OpenAI — only needed if LLM_PROVIDER is set to one of them
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-oss-120b   # groq; use e.g. gpt-4o-mini for openai

# Agent config
COMPANY_NAME=Acme Cloud         # Name the drafter signs replies as
CONFIDENCE_THRESHOLD=0.7        # Below this → flag for human review
CHROMA_PERSIST_DIR=./data/chroma_db
